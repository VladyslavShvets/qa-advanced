  "scripts": {
    "test": "jest --verbose",
    "test:hw15": "jest \"HW 15.1. Error Handling\" --verbose",
    "cy:open": "cypress open",
    "cy:run": "cypress run",
    "cy:run:qauto": "cypress run --config-file cypress.config.qauto.js --spec cypress/e2e/qauto_garage_expenses.cy.js",
    "cy:run:qauto2": "cypress run --config-file cypress.config.qauto2.js --spec cypress/e2e/qauto_garage_expenses.cy.js",
    "cy:run:firefox": "cypress run --browser firefox",
    "cy:run:firefox:qauto": "cypress run --browser firefox --config-file cypress.config.qauto.js --spec cypress/e2e/qauto_garage_expenses.cy.js",
    "cy:run:firefox:docker": "docker run --rm --platform linux/amd64 --cap-add=SYS_ADMIN --security-opt seccomp=unconfined -e MOZ_DISABLE_CONTENT_SANDBOX=1 -v \"$PWD\":/e2e -v cypress-firefox-node-modules-amd64:/e2e/node_modules -v cypress-firefox-cache-amd64:/root/.cache/Cypress -w /e2e cypress/browsers:node-22.13.1-chrome-132.0.6834.159-1-ff-134.0.2-edge-132.0.2957.127-1 sh -c \"npm ci && npx cypress run --browser firefox --config-file cypress.config.qauto.js --spec cypress/e2e/qauto_garage_expenses.cy.js\"",
    "pw:open": "playwright test --ui",
    "pw:run": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:staged": "node scripts/run-eslint-on-staged.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
